generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id Int @id @default(autoincrement())

  name String

  createdAt DateTime @default(now()) @map("created_at")

  // relasi
  events Event[]

  @@map("categories")
}

model Pembicara {
  id Int @id @default(autoincrement())

  name String
  role String
  image String

  createdAt DateTime @default(now()) @map("created_at")

  // relasi
  events Event[]

  @@map("pembicaras")
}

model Event {

  id Int @id @default(autoincrement())

  name String

  categoryId Int @map("category_id")

  pembicaraId Int @map("pembicara_id")

  location String

  dateEvent DateTime @map("date_event")

  description String

  createdAt DateTime @default(now()) @map("created_at")

  // RELASI
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  pembicara Pembicara @relation(fields: [pembicaraId], references: [id], onDelete: Cascade)

  @@map("events")
}